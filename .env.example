# Optional LiteLLM / OpenAI-compatible gateway. Secrets stay on the server.
# Without a gateway, the whole first edition plays with recorded/rule minds.
PORT=4318
WORLD_DATA_DIR=.runtime
MODEL_GATEWAY_URL=http://127.0.0.1:4000/v1
MODEL_GATEWAY_KEY=
MODEL_DIALOGUE=commandcode/deepseek/deepseek-v4.1-flash
MODEL_STRUCTURE=commandcode/deepseek/deepseek-v4.1-flash
MODEL_IMAGINATION=commandcode/deepseek/deepseek-v4.1-flash
MODEL_TIMEOUT_MS=12000
# Optional custom per-million-token prices for accurate cost accounting.
# Leave unset until the gateway's currency and actual prices are known.
# MODEL_INPUT_PRICE=1.00
# MODEL_OUTPUT_PRICE=2.00
